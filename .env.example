# Copy to .env and fill in. Never commit .env.

# Meta Model API (Muse Spark, Muse Wonder): dev.meta.ai -> API keys
MODEL_API_KEY=

# Optional: Muse Spark Open (Meta's open-weights model) on Baseten: app.baseten.co -> API keys
BASETEN_API_KEY=
# Optional: Muse Spark Open on Fireworks: fireworks.ai -> API keys
FIREWORKS_API_KEY=

# SEC EDGAR asks every client to identify itself: "Name email@example.com"
SEC_USER_AGENT=
